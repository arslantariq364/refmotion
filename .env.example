# ============================================================================
# UNICO — Open-Source Reference-Based Video Editing & Generation Platform
# Environment Configuration
# ============================================================================

# Server & Network Binding
UNICO_HOST=0.0.0.0
UNICO_PORT=8000
UNICO_LAN_IP=192.168.1.67
UNICO_ENV=development

# Authentication & Security
UNICO_SECRET_KEY=change-this-local-secret-key-in-production
UNICO_DEFAULT_ADMIN_USER=creator
UNICO_DEFAULT_ADMIN_PASSWORD=unico-local-studio
UNICO_REQUIRE_AUTH=false

# Storage & Database
UNICO_STORAGE_ROOT=./storage
UNICO_DATABASE_URL=sqlite:///./storage/database/unico.db
UNICO_MAX_UPLOAD_SIZE_MB=500
UNICO_CLEANUP_TEMP_HOURS=24

# Background Worker & Performance
UNICO_WORKER_CONCURRENCY=1
UNICO_WORKER_POLL_INTERVAL_SEC=1.5
UNICO_PREVIEW_RESOLUTION=720
UNICO_FFMPEG_THREADS=4
UNICO_SUBPROCESS_TIMEOUT_SEC=600

# External Tool Paths (auto-detected if on PATH)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MELT_PATH=/usr/bin/melt
SHOTCUT_PATH=/usr/bin/shotcut
REMOTION_PROJECT_DIR=/home/arslan-tariq/launch-video
RECORDLY_PROJECT_DIR=/home/arslan-tariq/recordly
VIDEO_TOOLS_REFVIDEOS_DIR=/home/arslan-tariq/Video_Tools/refvideos

# Optional Pluggable AI Provider Credentials (Leave blank for 100% local mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
COMFYUI_BASE_URL=http://127.0.0.1:8188
WHISPER_LOCAL_MODEL_PATH=
PIPER_TTS_MODEL_PATH=
